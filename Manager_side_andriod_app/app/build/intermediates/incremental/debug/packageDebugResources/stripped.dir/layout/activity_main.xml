<?xml version="1.0" encoding="utf-8"?>
<!-- Root ViewFlipper holds all 6 screens: LOGIN, HOME, METHOD_PICKER, SCANNER, RESULT, DETAIL -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- ═══════════════════════════════════════════════════════════
             SCREEN 0: MANAGER LOGIN
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/screenLogin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:background="@color/bg_dark">

            <!-- Logo -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/circle_bg_primary"
                android:gravity="center"
                android:text="🔒"
                android:textSize="36sp"
                android:layout_marginBottom="24dp" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manager Login"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter credentials to access scanning and local decryption keys."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="36dp" />

            <!-- Input Username -->
            <EditText
                android:id="@+id/loginUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@color/surface_dark"
                android:hint="Username"
                android:inputType="text"
                android:paddingHorizontal="18dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                android:backgroundTint="@color/surface_dark"
                tools:ignore="LabelFor" />

            <!-- Input Password -->
            <EditText
                android:id="@+id/loginPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="28dp"
                android:background="@color/surface_dark"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingHorizontal="18dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                android:backgroundTint="@color/surface_dark"
                tools:ignore="LabelFor" />

            <!-- Action Button -->
            <Button
                android:id="@+id/btnLoginSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="@color/color_primary"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="#0D1117"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             SCREEN 1: HOME
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@color/bg_dark">

            <!-- Navbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/homeTitleWelcome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Welcome, Manager"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHomeLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textColor="@color/color_error"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Scan Mode"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Action: Send to Desktop -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnSendToDesktop"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/color_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_bg_dark"
                        android:gravity="center"
                        android:text="🖥"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View in Desktop"
                            android:textColor="#0D1117"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan and transfer to desktop\nUSB · WiFi · Bluetooth"
                            android:textColor="#1A3A35"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#0D1117"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action: View on Mobile -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnViewOnMobile"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_bg_secondary"
                        android:gravity="center"
                        android:text="📱"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View in Mobile Only"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Retrieve and decrypt directly\nRequires Biometric auth"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/text_muted"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             SCREEN 2: METHOD PICKER (USB / WiFi / Bluetooth)
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/screenMethodPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_dark"
            android:padding="24dp">

            <!-- Back bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btnMethodBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Back"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Connection"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a connection method to send scanned QR data to the desktop app."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="28dp" />

            <!-- USB Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnMethodUsb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_bg_primary"
                        android:gravity="center"
                        android:text="🔌"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="USB Cable"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/badge_green"
                                android:text=" MOST SECURE "
                                android:textColor="@color/color_success"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physical cable · Secure direct link"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/text_muted"
                        android:textSize="22sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- WiFi Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnMethodWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_bg_warning"
                        android:gravity="center"
                        android:text="📶"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WiFi"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/badge_yellow"
                                android:text=" NETWORK "
                                android:textColor="@color/color_warning"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Same local WiFi · Enter laptop IP address"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/text_muted"
                        android:textSize="22sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WiFi IP input (hidden initially, shown when WiFi picked) -->
            <LinearLayout
                android:id="@+id/wifiInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter laptop IP address:"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/wifiIpInput"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/surface_dark"
                        android:hint="e.g. 192.168.1.10"
                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/text_muted"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginEnd="10dp"
                        tools:ignore="LabelFor" />

                    <Button
                        android:id="@+id/wifiConnectBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:backgroundTint="@color/color_primary"
                        android:text="Connect →"
                        android:textAllCaps="false"
                        android:textColor="#0D1117"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>



        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             SCREEN 3: QR SCANNER
             ═══════════════════════════════════════════════════════════ -->
        <FrameLayout
            android:id="@+id/screenScanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <!-- Camera preview (full screen) -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Dimming overlay (top + sides) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/scan_overlay" />

            <!-- Back button overlay -->
            <TextView
                android:id="@+id/btnScannerBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="#88000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="← Back"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Connection method badge (top-right) -->
            <TextView
                android:id="@+id/connectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="#88000000"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="🔌 USB"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Status card at bottom -->
            <androidx.cardview.widget.CardView
                android:id="@+id/scanStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/scanStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸  Align QR code within the frame"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/scanSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hold steady — auto-detects when in frame"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- ═══════════════════════════════════════════════════════════
             SCREEN 4: RESULT
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/screenResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@color/bg_dark">

            <!-- Result icon -->
            <TextView
                android:id="@+id/resultIcon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/circle_bg_primary"
                android:gravity="center"
                android:text="✅"
                android:textSize="40sp"
                android:layout_marginBottom="24dp" />

            <!-- Result title -->
            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Code Sent!"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Result subtitle -->
            <TextView
                android:id="@+id/resultSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data sent to desktop app.\nEnter manager password on laptop to view Form 16."
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Payload preview card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scanned Payload Preview"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/resultPayloadText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/color_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Scan again -->
            <Button
                android:id="@+id/btnScanAgain"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/color_primary"
                android:text="Scan Another QR Code"
                android:textAllCaps="false"
                android:textColor="#0D1117"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnResultHome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/surface_dark"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             SCREEN 5: FORM 16 DETAIL VIEW (MOBILE DECRYPTION)
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/screenDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_dark">

            <!-- Navbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@color/surface_dark"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/btnDetailBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Close"
                    android:textColor="@color/color_primary"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Form 16 Report"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginEnd="40dp" />
            </LinearLayout>

            <!-- Scrollable Report Details -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:scrollbarSize="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Basic Header details card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/surface_dark"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/detailEmpName"
                                android:layout_width="wrap_content"
